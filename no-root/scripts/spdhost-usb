#!/usr/bin/env bash
# Wait for one OTG device, then run spdhost with that file descriptor.
# Usage: spdhost-usb [fdl ...]
#        spdhost-usb /dev/bus/usb/N/M -- [fdl ...]
set -euo pipefail

if ! command -v termux-usb >/dev/null 2>&1; then
	echo "termux-usb is not on PATH. Install Termux:API from F-Droid and: pkg install termux-api" >&2
	exit 1
fi
bin=$(type -P spdhost || true)
if [[ -z ${bin} ]]; then
	echo "spdhost is not on PATH. From no-root/: make && cp spdhost \"\$PREFIX/bin/\"" >&2
	exit 1
fi

dev=
if [[ ${1:-} == /dev/bus/usb/* ]]; then
	dev=$1
	shift
	if [[ ${1:-} == -- ]]; then
		shift
	fi
fi

list_devs() {
	# termux-usb -l returns immediately. An empty list is normal until the
	# cable is plugged in, so the caller has to poll.
	termux-usb -l 2>/dev/null | tr -d '[]",' | awk '/\/dev\/bus\/usb\// { print $1 }' || true
}

if [[ -z $dev ]]; then
	echo "Waiting up to 90 seconds. Plug the target in NOW." >&2
	echo "Hold its download-mode keys (volume down) until this line changes." >&2
	echo "When the permission dialog appears, tap OK immediately." >&2
	deadline=$((SECONDS + 90))
	while (( SECONDS < deadline )); do
		mapfile -t devs < <(list_devs)
		if (( ${#devs[@]} == 1 )); then
			dev=${devs[0]}
			echo "found $dev" >&2
			break
		fi
		if (( ${#devs[@]} > 1 )); then
			printf 'more than one USB device; pass the path:\n' >&2
			printf '  %s\n' "${devs[@]}" >&2
			exit 1
		fi
		left=$((deadline - SECONDS))
		printf '\rstill waiting (%ds) ' "$left" >&2
		sleep 0.4
	done
	echo >&2
	if [[ -z $dev ]]; then
		echo "no USB device appeared. The BootROM only stays up a few seconds;" >&2
		echo "run this again and plug in while this wait is counting." >&2
		exit 1
	fi
fi

if [[ $# -eq 0 ]]; then
	echo "usage: spdhost-usb [/dev/bus/usb/N/M] -- <spdhost commands>" >&2
	exit 2
fi

run=$(mktemp "${TMPDIR:-/tmp}/spdhost-run.XXXXXX")
# Termux:API executes this file itself, without Termux's /bin/bash shim.
# The shebang has to be the real bash path.
bash_bin=$(command -v bash)
trap 'rm -f "$run"' EXIT
{
	printf '#!%s\n' "$bash_bin"
	printf 'exec'
	printf ' %q' "$bin" "$@"
	printf '\n'
} > "$run"
chmod +x "$run"
if ! "$bash_bin" -n "$run"; then
	echo "generated launcher failed a syntax check:" >&2
	cat "$run" >&2
	exit 1
fi
# Do not exec: keep this shell so the EXIT trap removes the temp launcher.
# Child spdhost remembers this path for post-EXEC reacquire when several
# USB nodes appear.
export SPDHOST_USB_BUS=$dev
termux-usb -r -E -e "$run" "$dev"
