#!/usr/bin/env bash
# Hand one OTG device to spdhost without root.
#
# termux-callback runs `$TERMUX_CALLBACK` with the variable unquoted, so the
# -e string is word-split and is not a shell command line. Passing
# `spdhost fdl file.bin 0x5500` would break on spaces and on %q quoting.
# Write a one-shot script and give termux-usb that path. -E puts the
# usbfs descriptor in TERMUX_USB_FD, which spdhost reads itself.
#
#   spdhost-usb fdl fdl1.bin FDL1_ADDR fdl fdl2.bin FDL2_ADDR parts
#   spdhost-usb /dev/bus/usb/001/002 -- read-part boot 0 64M boot.img
set -euo pipefail

if ! command -v termux-usb >/dev/null 2>&1; then
	echo "termux-usb is not on PATH. Install Termux:API from F-Droid and: pkg install termux-api" >&2
	exit 1
fi
bin=$(type -P spdhost || true)
if [[ -z ${bin} ]]; then
	echo "spdhost is not on PATH. From no-root/: make && cp spdhost \"\$PREFIX/bin/\"" >&2
	exit 1
fi

dev=
if [[ ${1:-} == /dev/bus/usb/* ]]; then
	dev=$1
	shift
	if [[ ${1:-} == -- ]]; then
		shift
	fi
fi

if [[ -z $dev ]]; then
	mapfile -t devs < <(termux-usb -l | tr -d '[]",' | awk '/\/dev\/bus\/usb\// { print $1 }')
	if [[ ${#devs[@]} -eq 0 ]]; then
		echo "termux-usb -l found nothing. Plug the phone in download mode through OTG." >&2
		exit 1
	fi
	if [[ ${#devs[@]} -gt 1 ]]; then
		printf 'more than one USB device; pass the path:\n' >&2
		printf '  %s\n' "${devs[@]}" >&2
		exit 1
	fi
	dev=${devs[0]}
fi

if [[ $# -eq 0 ]]; then
	echo "usage: spdhost-usb [/dev/bus/usb/N/M] -- <spdhost commands>" >&2
	exit 2
fi

run=$(mktemp "${TMPDIR:-/tmp}/spdhost-run.XXXXXX")
{
	printf '#!/bin/bash\nexec '
	printf '%q ' "$bin" "$@"
	printf '\n'
} > "$run"
chmod +x "$run"
exec termux-usb -r -E -e "$run" "$dev"
