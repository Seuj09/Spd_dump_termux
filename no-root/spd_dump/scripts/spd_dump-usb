#!/usr/bin/env bash
# Wait for one OTG device, then run spd_dump with that file descriptor.
# Usage: spd_dump-usb [spd_dump options and commands ...]
#        spd_dump-usb /dev/bus/usb/N/M -- [spd_dump options and commands ...]
#
# Environment:
#   SPD_USB_WAIT=N            seconds to wait for the device to show up (default 90)
#   SPD_WAKE_LOCK=0           do not hold a Termux wake lock while spd_dump runs
#   SPD_USB_ATTACHED_GRACE=N  seconds before accepting an already-attached single
#                             device (warm path). Default 0 — shrink Allow→spawn
#                             latency when racing a short BootROM window. Cold
#                             new-device detection is unchanged.
#   SPD_USB_SKIP_REQUEST=1    omit termux-usb -r (warm already-authorized
#                             experiments only). Default keeps -r so Android
#                             shows Allow after every replug.
#   SPD_USB_LIST_TIMEOUT=N    timeout seconds for each termux-usb -l (default 8)
#   SPD_USB_NO_SYSFS=1        do not read idVendor under /sys/bus/usb/devices.
#                             Default tries. A host that blocks sysfs keeps
#                             the path-only choice (one new path, or the
#                             single already-attached path).
#   SPD_USB_ANY=1             (read by spd_dump) skip the 1782:4d00 ID check
#   SPD_USB_BUS               set by this script to the chosen /dev/bus/usb path
#
# Always-on thin stderr timing (monotonic-ish ms from script start):
#   usb: listed $dev @Xms
#   usb: termux-usb -e start @Yms
#   usb: child start fd=N @Zms   (inside the generated launcher, before exec)
#
# How it works: termux-usb opens the device through the Termux:API app and runs
# a launcher with the file descriptor. Newer termux-api packages export it as
# TERMUX_USB_FD (-E); older ones pass it as the first argument. The launcher
# accepts both and hands it to spd_dump as --usb-fd <fd> (next-arg form —
# spd_dump supports next-arg + env; not last-argv).
set -euo pipefail

_here=$(cd "$(dirname "$0")" && pwd)
_usb_pick=
if [[ -f $_here/usb-pick.sh ]]; then
	_usb_pick=$_here/usb-pick.sh
elif [[ -f $_here/../../scripts/usb-pick.sh ]]; then
	_usb_pick=$_here/../../scripts/usb-pick.sh
fi
if [[ -z $_usb_pick ]]; then
	echo "usb-pick.sh not found next to spd_dump-usb" >&2
	exit 1
fi
# shellcheck source=../../scripts/usb-pick.sh
source "$_usb_pick"

run= rcfile= wl=0
cleanup() {
	[[ -n $run ]] && rm -f "$run"
	[[ -n $rcfile ]] && rm -f "$rcfile"
	if (( wl )); then termux-wake-unlock >/dev/null 2>&1 || true; fi
}
trap cleanup EXIT

# Monotonic-ish ms since script start (EPOCHREALTIME / %s%N / seconds*1000).
_usb_t0=
_usb_now_ms() {
	if [[ -n ${EPOCHREALTIME-} ]]; then
		# bash 5+: seconds.microseconds
		awk -v t="$EPOCHREALTIME" -v t0="${_usb_t0:-0}" 'BEGIN { printf "%d", (t - t0) * 1000 }'
		return
	fi
	local ns
	ns=$(date +%s%N 2>/dev/null) || ns=
	if [[ $ns =~ ^[0-9]+$ && ${#ns} -ge 10 ]]; then
		# ns since epoch; t0 stored the same way
		awk -v t="$ns" -v t0="${_usb_t0:-0}" 'BEGIN { printf "%d", (t - t0) / 1e6 }'
		return
	fi
	# Fallback: whole seconds
	awk -v t="$SECONDS" -v t0="${_usb_t0_sec:-0}" 'BEGIN { printf "%d", (t - t0) * 1000 }'
}
_usb_init_clock() {
	if [[ -n ${EPOCHREALTIME-} ]]; then
		_usb_t0=$EPOCHREALTIME
	else
		local ns
		ns=$(date +%s%N 2>/dev/null) || ns=
		if [[ $ns =~ ^[0-9]+$ && ${#ns} -ge 10 ]]; then
			_usb_t0=$ns
		else
			_usb_t0=0
			_usb_t0_sec=$SECONDS
		fi
	fi
}
_usb_init_clock

usb_log() {
	# Always-on thin timing lines.
	printf 'usb: %s @%sms\n' "$*" "$(_usb_now_ms)" >&2
}

if ! command -v termux-usb >/dev/null 2>&1; then
	echo "termux-usb is not on PATH. Install Termux:API from F-Droid and: pkg install termux-api" >&2
	exit 1
fi

# Bounded runner: termux-usb can hang forever if the Termux:API app is missing
# or was killed by battery optimisation.
if command -v timeout >/dev/null 2>&1; then
	bounded() { local t=$1; shift; timeout "$t" "$@"; }
else
	bounded() { shift; "$@"; }
fi

# Prefer a binary next to this package (unzipped no-root/spd_dump/), then PATH.
# Absolute path so the termux-usb child launcher keeps a stable exec target.
resolve_spd_dump() {
	local script_dir cand
	script_dir=$(cd "$(dirname "$0")" && pwd)
	for cand in \
		"$script_dir/../spd_dump" \
		"$PWD/spd_dump" \
		"$PWD/../spd_dump" \
		"$(type -P spd_dump 2>/dev/null || true)"
	do
		[[ -n $cand && -x $cand && -f $cand ]] || continue
		# Resolve .. and relative hits to an absolute path.
		(cd "$(dirname "$cand")" && printf '%s/%s\n' "$(pwd)" "$(basename "$cand")")
		return 0
	done
	return 1
}

bin=$(resolve_spd_dump) || {
	echo "spd_dump not found next to this tree or on PATH." >&2
	echo "From no-root/spd_dump/: make   (Termux: pkg install libusb clang make)" >&2
	exit 1
}

dev=
if [[ ${1:-} == /dev/bus/usb/* ]]; then
	dev=$1
	shift
	if [[ ${1:-} == -- ]]; then
		shift
	fi
fi

if [[ $# -eq 0 ]]; then
	echo "usage: spd_dump-usb [/dev/bus/usb/N/M] -- <spd_dump commands>" >&2
	exit 2
fi

# Probe -E support once, early — before wait — so find→-e has no extra work.
envflag=()
usage=$(bounded 5 termux-usb -h 2>&1 || true)   # capture first: grep -q + pipefail is racy
if [[ $usage == *" -E "* ]]; then
	envflag=(-E)
fi

# Pre-build launcher + rcfile before the wait ends so find→-e is only export + exec.
tmpdir=${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}
mkdir -p "$tmpdir"
run=$(mktemp "$tmpdir/spd_dump-run.XXXXXX")
rcfile=$(mktemp "$tmpdir/spd_dump-rc.XXXXXX")
# termux-callback runs the launcher as an unquoted word, so no whitespace.
if [[ $run == *[[:space:]]* || $rcfile == *[[:space:]]* ]]; then
	echo "temp directory path contains whitespace: $tmpdir (set TMPDIR to a plain path)" >&2
	exit 1
fi
: > "$rcfile"   # stays empty unless spd_dump actually ran

# Termux:API executes this file itself, without Termux's /bin/bash shim.
# The shebang has to be the real bash path.
bash_bin=$(command -v bash)
# Child timing: same clock basis as parent when EPOCHREALTIME / %s%N available.
# Fall back to SECONDS*1000 inside the child if needed.
{
	printf '#!%s\n' "$bash_bin"
	# stdout of a termux-usb -e child is buffered by termux-usb until it exits.
	# Send it to stderr so progress is visible live.
	printf 'exec 1>&2\n'
	printf 'fd=${TERMUX_USB_FD:-${1:-}}\n'
	printf 'if [ -z "$fd" ]; then\n'
	printf '\techo "spd_dump-usb: termux-usb gave no file descriptor" >&2\n'
	printf '\techo 97 > %q\n\texit 97\nfi\n' "$rcfile"
	# Thin child-start breadcrumb (always-on), ms since epoch-ish or SECONDS.
	printf '_t0=%q\n' "${_usb_t0}"
	printf 'if [ -n "${EPOCHREALTIME-}" ]; then\n'
	printf '\t_ms=$(awk -v t="$EPOCHREALTIME" -v t0="$_t0" '\''BEGIN { printf "%%d", (t - t0) * 1000 }'\'')\n'
	printf 'elif _ns=$(date +%%s%%N 2>/dev/null) && [ -n "$_ns" ]; then\n'
	printf '\t_ms=$(awk -v t="$_ns" -v t0="$_t0" '\''BEGIN { printf "%%d", (t - t0) / 1e6 }'\'')\n'
	printf 'else\n'
	printf '\t_ms=$((SECONDS * 1000))\n'
	printf 'fi\n'
	printf 'echo "usb: child start fd=$fd @${_ms}ms" >&2\n'
	# --usb-fd takes the NEXT argument (spd_dump parse), not last-argv.
	printf '%q --usb-fd "$fd"' "$bin"
	printf ' %q' "$@"
	printf '\n'
	printf 'rc=$?\n'
	printf 'echo "$rc" > %q\n' "$rcfile"
	printf 'exit "$rc"\n'
} > "$run"
chmod +x "$run"
if ! "$bash_bin" -n "$run"; then
	echo "generated launcher failed a syntax check:" >&2
	cat "$run" >&2
	exit 1
fi

# Fills the global array devs. termux-usb -l returns immediately; an empty list
# is normal until the cable is plugged in, so the caller has to poll.
devs=()
list_timeouts=0
poll_devs() {
	local out rc=0
	out=$(bounded "${SPD_USB_LIST_TIMEOUT:-8}" termux-usb -l 2>/dev/null) || rc=$?
	# 124: the list hung. Any other non-zero with no text is the API missing.
	# A list that did print devices is still parsed. Three in a row abort.
	if (( rc == 124 )) || { (( rc != 0 )) && [[ -z $out ]]; }; then
		list_timeouts=$((list_timeouts + 1))
		USB_PATHS=()
		USB_VIDS=()
		devs=()
		return 0
	fi
	list_timeouts=0
	usb_parse_list "$out"
	devs=()
	if (( ${#USB_PATHS[@]} )); then
		devs=("${USB_PATHS[@]}")
	fi
	return 0
}

api_hint() {
	echo "termux-usb did not answer. Check that:" >&2
	echo "  - the Termux:API app is installed from the same source as Termux (F-Droid)" >&2
	echo "  - you opened the Termux:API app once, and battery optimisation is off for it" >&2
	echo "  - the package is installed: pkg install termux-api" >&2
}

attached_grace=${SPD_USB_ATTACHED_GRACE:-0}
[[ $attached_grace =~ ^[0-9]+$ ]] || attached_grace=0

if [[ -z $dev ]]; then
	wait_s=${SPD_USB_WAIT:-90}
	[[ $wait_s =~ ^[0-9]+$ ]] || wait_s=90
	echo "Waiting up to ${wait_s} seconds. Plug the target in NOW." >&2
	echo "Hold its download-mode keys (volume down) until this line changes." >&2
	echo "When the permission dialog appears, tap OK immediately." >&2

	# Snapshot only. Deciding on this poll would open a charger that is
	# already plugged in and miss the phone that shows up on the next one.
	poll_devs
	USB_BASE=("${USB_PATHS[@]+"${USB_PATHS[@]}"}")
	base=("${devs[@]+"${devs[@]}"}")
	if (( ${#base[@]} > 0 )); then
		printf 'already attached (a single device with no vendor id, or the only vendor 1782, can be used): %s\n' "${base[*]}" >&2
	fi

	start=$SECONDS
	USB_START=$start
	USB_GRACE=$attached_grace
	deadline=$((SECONDS + wait_s))
	while (( SECONDS < deadline )); do
		poll_at=$(usb_now_ms)
		poll_devs
		if (( list_timeouts >= 3 )); then
			echo >&2
			api_hint
			exit 1
		fi
		usb_decide
		if [[ $USB_ACTION == take ]]; then
			dev=$USB_CHOSEN
			echo >&2
			case $USB_TAKE_WHY in
				unisoc)
					echo "found $dev (vendor 1782; other USB devices left alone)" >&2
					;;
				warm)
					echo "using already attached $dev" >&2
					;;
				*)
					echo "found $dev" >&2
					;;
			esac
			break
		fi
		if [[ $USB_ACTION == fail ]]; then
			usb_print_fail "spd_dump-usb"
			exit 1
		fi
		left=$((deadline - SECONDS))
		printf '\rstill waiting (%ds) ' "$left" >&2
		usb_pace_since "$poll_at" 300
	done
	echo >&2
	if [[ -z $dev ]]; then
		if (( ${#base[@]} > 1 )); then
			echo "several USB devices are attached and none is new:" >&2
			printf '  %s\n' "${base[@]}" >&2
			echo "pass the right one: spd_dump-usb /dev/bus/usb/N/M -- <commands>" >&2
			if (( ${USB_SAW_OTHER:-0} )); then
				echo "A device that did appear is not vendor 1782 (not the download-mode phone)." >&2
			fi
		else
			echo "no USB device appeared. The BootROM only stays up a few seconds;" >&2
			echo "run this again and plug in while this wait is counting." >&2
			if (( ${USB_SAW_OTHER:-0} )); then
				echo "A device that did appear is not vendor 1782 (not the download-mode phone)." >&2
			fi
		fi
		exit 1
	fi
fi

usb_log "listed $dev"

# Keep the CPU awake for long dumps (released on exit).
if [[ ${SPD_WAKE_LOCK:-1} != 0 ]] && command -v termux-wake-lock >/dev/null 2>&1; then
	termux-wake-lock >/dev/null 2>&1 && wl=1 || true
fi

# -r request permission (Android asks again after every replug) unless
# SPD_USB_SKIP_REQUEST=1 (warm already-authorized experiments).
# -E export TERMUX_USB_FD when supported; -e run launcher with that FD.
# Keep a single combined termux-usb -r … -e round (do not split).
export SPD_USB_BUS=$dev
reqflag=(-r)
if [[ ${SPD_USB_SKIP_REQUEST:-0} == 1 ]]; then
	reqflag=()
fi
usb_log "termux-usb -e start"
set +e
termux-usb ${reqflag[@]+"${reqflag[@]}"} ${envflag[@]+"${envflag[@]}"} -e "$run" "$dev"
term_rc=$?
set -e

rc=$(cat "$rcfile" 2>/dev/null || true)
if [[ -z $rc ]]; then
	echo "spd_dump never started (termux-usb exit $term_rc). Look at the message above:" >&2
	echo "  Permission denied / timeout: tap OK on the dialog within 30 seconds." >&2
	echo "  No such device: the device left download mode; replug and retry." >&2
	echo "  Open device failed: replug the cable and retry." >&2
	exit 1
fi
if [[ $rc == 97 ]]; then
	echo "termux-usb ran the launcher without a file descriptor." >&2
	echo "Update the package: pkg upgrade termux-api" >&2
fi
exit "$rc"
